{
  "application": {
    "language": "ja-JP"
  },
  "server": {
    "databasePath": "data/hataori.db",
    "controlPipeName": "hataori-control",
    "mcpHost": "127.0.0.1",
    "mcpPort": 45440,
    "mcpPath": "/mcp"
  },
  "itoguruma": {
    "endpoint": "http://127.0.0.1:47631/mcp",
    "agentId": "hataori",
    "agentType": "hataori",
    "connectionTimeoutSeconds": 10,
    "pollIntervalSeconds": 5,
    "maxReconnectAttempts": 5,
    "receiveBatchSize": 50,
    "leaseSeconds": 300
  },
  "agents": {
    "codex": {
      "executablePath": "codex",
      "sandboxMode": "workspace-write",
      "approveForMe": true,
      "skipGitRepoCheck": true,
      "maxCapturedCharacters": 4194304
    },
    "claudeCode": {
      "executablePath": "claude",
      "permissionMode": "acceptEdits",
      "maxCapturedCharacters": 4194304
    }
  },
  "activation": {
    "enabled": false,
    "workspaces": [
      {
        "workspaceId": "default",
        "workingDirectory": ""
      }
    ],
    "pollIntervalMilliseconds": 1000,
    "providerPriority": [ "codex", "claude-code" ],
    "maxConcurrentRuns": {
      "codex": 2,
      "claude-code": 2
    }
  },
  "replyRetry": {
    "enabled": true,
    "maxAttempts": 5,
    "initialDelaySeconds": 5,
    "maximumDelaySeconds": 300,
    "batchSize": 20,
    "pollIntervalMilliseconds": 1000
  },
  "fileLogging": {
    "enabled": true,
    "directoryPath": "logs",
    "minimumLevel": "Information",
    "retentionDays": 30
  },
  "databaseMaintenance": {
    "enabled": true,
    "intervalHours": 24,
    "staleTaskHours": 24,
    "taskRetentionDays": 90,
    "agentRunRetentionDays": 30,
    "messageRetentionDays": 30,
    "vacuum": true
  },
  "hooks": {
    "enabled": true,
    "codexConfigPath": "bin/cli/hooks/codex-hooks.json",
    "claudeConfigPath": "bin/cli/hooks/claude-settings.json"
  },
  "allowedHosts": "127.0.0.1;localhost"
}
