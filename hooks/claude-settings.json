{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "hataori hook", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "hataori hook", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|Bash", "hooks": [ { "type": "command", "command": "hataori hook", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "hataori hook", "timeout": 10 } ] }
    ]
  }
}
