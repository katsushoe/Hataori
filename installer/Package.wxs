<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Hataori"
           Manufacturer="Akatsukisoft"
           Version="$(var.ProductVersion)"
           UpgradeCode="6AF718AA-029F-4DBC-AB8E-B5E00C9A7E22"
           Scope="perUser"
           Language="1041"
           Codepage="932"
           InstallerVersion="500">
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of Hataori is already installed." />
    <Property Id="LEGACYHATAORISERVICE" Secure="yes">
      <RegistrySearch Id="LegacyHataoriService" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\Hataori" Name="ImagePath" Type="raw" />
    </Property>
    <Property Id="INSTALL_ROOT" Secure="yes">
      <RegistrySearch Id="PreviousUserInstallRoot" Root="HKCU" Key="Software\Akatsukisoft\Hataori" Name="InstallRoot" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR NOT LEGACYHATAORISERVICE" Message="Uninstall the legacy machine-wide Hataori Windows Service before installing the user edition." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="HataoriIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)..\assets\icon\hataori.ico" />
    <Property Id="ARPPRODUCTICON" Value="HataoriIcon.ico" />
    <Property Id="HATAORI_LANGUAGE" Value="ja-JP" Secure="yes" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALL_ROOT" />

    <UI>
      <Dialog Id="LanguageDlg" Width="370" Height="210" Title="Hataori Setup / セットアップ">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="24" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Select language / 言語を選択" />
        <Control Id="Description" Type="Text" X="20" Y="47" Width="330" Height="30" Text="Select the language used by Hataori.&#13;&#10;Hataoriで使用する言語を選択してください。" />
        <Control Id="Language" Type="RadioButtonGroup" X="30" Y="85" Width="300" Height="50" Property="HATAORI_LANGUAGE">
          <RadioButtonGroup Property="HATAORI_LANGUAGE">
            <RadioButton Value="ja-JP" X="0" Y="0" Width="250" Height="17" Text="日本語 (Japanese)" />
            <RadioButton Value="en-US" X="0" Y="24" Width="250" Height="17" Text="English (英語)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="176" Width="56" Height="17" Default="yes" Text="Next / 次へ">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="300" Y="176" Width="56" Height="17" Cancel="yes" Text="Cancel / 中止">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
    </UI>

    <InstallUISequence>
      <Show Dialog="LanguageDlg" Before="CostFinalize" Condition="NOT Installed AND UILevel &gt;= 4" />
    </InstallUISequence>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALL_ROOT" Name="Hataori" ComponentGuidGenerationSeed="0A665181-5372-47F2-B6AA-60D58A4BA888">
        <Directory Id="BINDIR" Name="bin">
          <Directory Id="SERVERDIR" Name="server">
            <Component Id="ServerExecutable" Guid="D0D62639-E3DB-461C-8B1A-FC6ADD7606DB" Bitness="always64">
              <File Id="ServerExe" Source="$(var.PublishRoot)\server\Hataori.Server.exe" />
              <RegistryValue Root="HKCU" Key="Software\Akatsukisoft\Hataori\Components" Name="Server" Value="1" Type="integer" KeyPath="yes" />
              <RemoveFolder Id="RemoveServerDir" On="uninstall" />
              <RemoveFolder Id="RemoveBinDir" Directory="BINDIR" On="uninstall" />
              <RemoveFolder Id="RemoveRootIfEmpty" Directory="INSTALL_ROOT" On="uninstall" />
            </Component>
          </Directory>
          <Directory Id="CLIDIR" Name="cli">
            <Component Id="CliExecutable" Guid="DC5CBDFF-DC23-4C76-A1A8-5B5013CC40AC" Bitness="always64">
              <File Id="CliExe" Source="$(var.PublishRoot)\cli\Hataori.Cli.exe" />
              <RegistryValue Root="HKCU" Key="Software\Akatsukisoft\Hataori\Components" Name="Cli" Value="1" Type="integer" KeyPath="yes" />
              <RemoveFolder Id="RemoveCliDir" On="uninstall" />
              <Environment Id="HataoriPath" Name="PATH" Value="[CLIDIR]" Action="set" Part="last" System="no" />
            </Component>
            <Directory Id="HOOKSDIR" Name="hooks">
              <Component Id="HookTemplates" Guid="3A23DFAF-02A8-4EC6-A56F-56542B0A6271" Bitness="always64">
                <File Id="CodexHooks" Source="$(var.PublishRoot)\cli\hooks\codex-hooks.json" />
                <File Id="ClaudeHooks" Source="$(var.PublishRoot)\cli\hooks\claude-settings.json" />
                <RegistryValue Root="HKCU" Key="Software\Akatsukisoft\Hataori\Components" Name="Hooks" Value="1" Type="integer" KeyPath="yes" />
                <RemoveFolder Id="RemoveHooksDir" On="uninstall" />
              </Component>
            </Directory>
          </Directory>
          <Directory Id="MONITORDIR" Name="monitor">
            <Component Id="MonitorExecutable" Guid="4FC00E99-25FF-45A8-AD94-A41CB61CF44D" Bitness="always64">
              <File Id="MonitorExe" Source="$(var.PublishRoot)\monitor\Hataori.Monitor.exe" />
              <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Hataori" Value="&quot;[#MonitorExe]&quot; --startup" Type="string" KeyPath="yes" />
              <RegistryValue Root="HKCU" Key="Software\Akatsukisoft\Hataori" Name="InstallRoot" Value="[INSTALL_ROOT]" Type="string" />
              <Shortcut Id="MonitorShortcut" Directory="ProgramMenuFolder" Name="Hataori Monitor" Target="[#MonitorExe]" WorkingDirectory="INSTALL_ROOT" />
              <RemoveFolder Id="RemoveMonitorDir" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
        <Directory Id="CONFIGDIR" Name="config">
          <Component Id="PreservedConfigDirectory" Guid="0FA320C5-E174-4695-A860-6EB00E6472C7" Permanent="yes" NeverOverwrite="yes" Bitness="always64">
            <CreateFolder />
            <RemoveFolder Id="RemoveConfigIfEmpty" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Akatsukisoft\Hataori\Paths" Name="Config" Value="[CONFIGDIR]" Type="string" KeyPath="yes" />
          </Component>
        </Directory>
        <Directory Id="LOGSDIR" Name="logs">
          <Component Id="PreservedLogsDirectory" Guid="51D17CCD-083E-4105-ACB4-C1C8EE203BEC" Permanent="yes" NeverOverwrite="yes" Bitness="always64">
            <CreateFolder />
            <RemoveFolder Id="RemoveLogsIfEmpty" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Akatsukisoft\Hataori\Paths" Name="Logs" Value="[LOGSDIR]" Type="string" KeyPath="yes" />
          </Component>
        </Directory>
        <Directory Id="DATADIR" Name="data">
          <Component Id="PreservedDataDirectory" Guid="72B71F6D-03F3-488F-B12A-B59DD2434E32" Permanent="yes" NeverOverwrite="yes" Bitness="always64">
            <CreateFolder />
            <RemoveFolder Id="RemoveDataIfEmpty" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Akatsukisoft\Hataori\Paths" Name="Data" Value="[DATADIR]" Type="string" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="Hataori" Level="1">
      <ComponentRef Id="ServerExecutable" />
      <ComponentRef Id="CliExecutable" />
      <ComponentRef Id="HookTemplates" />
      <ComponentRef Id="MonitorExecutable" />
      <ComponentRef Id="PreservedConfigDirectory" />
      <ComponentRef Id="PreservedLogsDirectory" />
      <ComponentRef Id="PreservedDataDirectory" />
    </Feature>

    <CustomAction Id="InitializeConfiguration"
                  FileRef="CliExe"
                  ExeCommand="config init --config &quot;[CONFIGDIR]hataori.json&quot; --language &quot;[HATAORI_LANGUAGE]&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />
    <CustomAction Id="StopTray" Directory="MONITORDIR"
                  ExeCommand="&quot;[MONITORDIR]Hataori.Monitor.exe&quot; --stop"
                  Execute="immediate" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="StopTray" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="InitializeConfiguration" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
